{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plonix",
  "mainBinaryName": "Plonix",
  "version": "0.1.0",
  "identifier": "io.github.sergeymalych.plonix",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "externalBin": ["binaries/plonix-cli"],
    "shortDescription": "Web security research workbench",
    "longDescription": "Plonix captures HTTP and HTTPS traffic, learns the target's real scope as you browse, and lets you search, replay and compare requests.",
    "copyright": "Plonix contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/SergeyMalych/plonix/releases/latest/download/latest.json"]
    }
  }
}
