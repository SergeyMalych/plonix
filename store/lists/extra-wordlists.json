{
  "plonix_lists": 1,
  "name": "extra-wordlists",
  "version": "1.0.0",
  "description": "More starting-point lists for the Bench: id formats, ports, and common API paths.",
  "author": "Plonix contributors",
  "homepage": "https://github.com/SergeyMalych/plonix",
  "lists": [
    {
      "id": "id-formats",
      "title": "Identifier formats",
      "description": "Example id shapes to try where a numeric id is expected.",
      "values": [
        "0",
        "1",
        "-1",
        "00000000-0000-0000-0000-000000000000",
        "11111111-1111-1111-1111-111111111111",
        "9999999999",
        "1e10",
        "0x1",
        "[0]",
        "1,2"
      ]
    },
    {
      "id": "common-ports",
      "title": "Common ports",
      "description": "Ports to try against a host or in a port parameter.",
      "values": [
        "80",
        "443",
        "8080",
        "8443",
        "3000",
        "5000",
        "8000",
        "8888",
        "9000",
        "9090"
      ]
    },
    {
      "id": "api-paths",
      "title": "API paths",
      "description": "API endpoints worth probing beyond the built-in common paths.",
      "values": [
        "api/v2",
        "api/v3",
        "graphql",
        "graphiql",
        "api/graphql",
        "rest",
        "rpc",
        "api/users",
        "api/user",
        "api/me",
        "api/admin",
        "api/login",
        "api/token",
        "api/keys",
        "actuator",
        "actuator/health",
        "debug",
        "internal"
      ]
    }
  ]
}
