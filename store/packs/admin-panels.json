{
  "plonix_pack": 1,
  "name": "admin-panels",
  "version": "1.0.0",
  "description": "DevOps tools and admin consoles that are often exposed by mistake.",
  "author": "Plonix contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SergeyMalych/plonix",
  "rules": [
    {"id": "jenkins", "name": "Jenkins", "category": "devops", "website": "https://www.jenkins.io", "implies": ["java"],
     "conditions": [{"header": "X-Jenkins", "regex": "([\\d.]+)", "version": "$1"}, {"header": "X-Hudson"}, {"cookie": "JSESSIONID.*"}]},
    {"id": "gitlab", "name": "GitLab", "category": "devops", "website": "https://about.gitlab.com",
     "conditions": [{"cookie": "_gitlab_session"}, {"header": "X-Gitlab-Meta"}, {"body": "<meta content=\"GitLab\" property=\"og:site_name\""}]},
    {"id": "grafana", "name": "Grafana", "category": "devops", "website": "https://grafana.com",
     "conditions": [{"cookie": "grafana_session"}, {"body": "\"buildInfo\":\\{[^}]*\"version\":\"([\\d.]+)\"", "version": "$1"}],
     "confidence": 90},
    {"id": "kibana", "name": "Kibana", "category": "devops", "website": "https://www.elastic.co/kibana",
     "conditions": [{"header": "kbn-name"}, {"header": "kbn-version", "regex": "([\\d.]+)", "version": "$1"}]},
    {"id": "elasticsearch", "name": "Elasticsearch", "category": "database", "website": "https://www.elastic.co/elasticsearch",
     "conditions": [{"header": "X-elastic-product", "regex": "^Elasticsearch$"}, {"body": "\"tagline\"\\s*:\\s*\"You Know, for Search\""}]},
    {"id": "prometheus", "name": "Prometheus", "category": "devops", "website": "https://prometheus.io",
     "conditions": [{"path": "^/api/v1/(?:query|targets|status/config)"}, {"body": "<title>Prometheus Time Series Collection and Processing Server</title>"}]},
    {"id": "argocd", "name": "Argo CD", "category": "devops", "website": "https://argo-cd.readthedocs.io",
     "conditions": [{"cookie": "argocd.token"}, {"body": "<title>Argo CD</title>"}]},
    {"id": "sonarqube", "name": "SonarQube", "category": "devops", "website": "https://www.sonarsource.com",
     "conditions": [{"path": "^/api/server/version$"}, {"body": "window\\.baseUrl = .*sonar"}], "match": "any", "confidence": 60},
    {"id": "jira", "name": "Jira", "category": "devops", "website": "https://www.atlassian.com/software/jira",
     "conditions": [{"header": "X-AREQUESTID"}, {"cookie": "atlassian.xsrf.token"}, {"body": "<meta name=\"application-name\" content=\"JIRA\""}]},
    {"id": "confluence", "name": "Confluence", "category": "devops", "website": "https://www.atlassian.com/software/confluence",
     "conditions": [{"header": "X-Confluence-Request-Time"}, {"body": "<meta name=\"confluence-request-time\""}]},
    {"id": "phpmyadmin", "name": "phpMyAdmin", "category": "database", "website": "https://www.phpmyadmin.net", "implies": ["php"],
     "conditions": [{"cookie": "phpMyAdmin"}, {"cookie": "pma_lang"}, {"body": "<title>phpMyAdmin"}]},
    {"id": "kubernetes-dashboard", "name": "Kubernetes Dashboard", "category": "devops",
     "conditions": [{"body": "<title>Kubernetes Dashboard</title>"}, {"path": "^/api/v1/csrftoken/login$"}]},
    {"id": "minio", "name": "MinIO", "category": "hosting", "website": "https://min.io",
     "conditions": [{"header": "Server", "regex": "^MinIO"}, {"header": "X-Minio-Deployment-Id"}]}
  ]
}
