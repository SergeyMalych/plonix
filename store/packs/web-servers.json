{
  "plonix_pack": 1,
  "name": "web-servers",
  "version": "1.0.0",
  "description": "Common HTTP servers and application servers, from response headers.",
  "author": "Plonix contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SergeyMalych/plonix",
  "rules": [
    {"id": "nginx", "name": "nginx", "category": "web-server", "website": "https://nginx.org",
     "conditions": [{"header": "Server", "regex": "^nginx(?:/([\\d.]+))?", "version": "$1"}]},
    {"id": "openresty", "name": "OpenResty", "category": "web-server", "website": "https://openresty.org", "implies": ["nginx"],
     "conditions": [{"header": "Server", "regex": "^openresty(?:/([\\d.]+))?", "version": "$1"}]},
    {"id": "apache-httpd", "name": "Apache HTTP Server", "category": "web-server", "website": "https://httpd.apache.org",
     "conditions": [{"header": "Server", "regex": "^Apache(?:/([\\d.]+))?(?:\\s|$)", "version": "$1"}]},
    {"id": "iis", "name": "Microsoft IIS", "category": "web-server", "website": "https://www.iis.net", "implies": ["windows-server"],
     "conditions": [{"header": "Server", "regex": "^Microsoft-IIS(?:/([\\d.]+))?", "version": "$1"}]},
    {"id": "windows-server", "name": "Windows Server", "category": "hosting", "confidence": 80,
     "conditions": [{"header": "Server", "regex": "Microsoft-HTTPAPI"}]},
    {"id": "litespeed", "name": "LiteSpeed", "category": "web-server", "website": "https://www.litespeedtech.com",
     "conditions": [{"header": "Server", "regex": "^LiteSpeed"}, {"header": "X-LiteSpeed-Cache"}]},
    {"id": "caddy", "name": "Caddy", "category": "web-server", "website": "https://caddyserver.com",
     "conditions": [{"header": "Server", "regex": "^Caddy"}]},
    {"id": "envoy", "name": "Envoy", "category": "load-balancer", "website": "https://www.envoyproxy.io",
     "conditions": [{"header": "Server", "regex": "^envoy"}, {"header": "x-envoy-upstream-service-time"}]},
    {"id": "traefik", "name": "Traefik", "category": "load-balancer", "website": "https://traefik.io", "confidence": 80,
     "conditions": [{"header": "Server", "regex": "^Traefik"}]},
    {"id": "haproxy", "name": "HAProxy", "category": "load-balancer", "website": "https://www.haproxy.org",
     "conditions": [{"header": "Server", "regex": "^HAProxy"}, {"cookie": "SERVERID", "regex": "^[a-z0-9_-]+$"}],
     "confidence": 70},
    {"id": "gunicorn", "name": "Gunicorn", "category": "web-server", "website": "https://gunicorn.org", "implies": ["python"],
     "conditions": [{"header": "Server", "regex": "^gunicorn(?:/([\\d.]+))?", "version": "$1"}]},
    {"id": "uvicorn", "name": "Uvicorn", "category": "web-server", "website": "https://www.uvicorn.org", "implies": ["python"],
     "conditions": [{"header": "Server", "regex": "^uvicorn"}]},
    {"id": "werkzeug", "name": "Werkzeug", "category": "web-server", "implies": ["python"],
     "description": "Python development server; often means a debug build is exposed.",
     "conditions": [{"header": "Server", "regex": "^Werkzeug(?:/([\\d.]+))?", "version": "$1"}]},
    {"id": "jetty", "name": "Jetty", "category": "web-server", "website": "https://jetty.org", "implies": ["java"],
     "conditions": [{"header": "Server", "regex": "^Jetty(?:\\(([\\d.]+)[^)]*\\))?", "version": "$1"}]},
    {"id": "tomcat", "name": "Apache Tomcat", "category": "web-server", "website": "https://tomcat.apache.org", "implies": ["java"],
     "conditions": [{"header": "Server", "regex": "^Apache-Coyote"}, {"body": "<h3>Apache Tomcat/([\\d.]+)</h3>", "version": "$1"}]},
    {"id": "kestrel", "name": "Kestrel", "category": "web-server", "implies": ["aspnet"],
     "conditions": [{"header": "Server", "regex": "^Kestrel"}]},
    {"id": "cowboy", "name": "Cowboy", "category": "web-server", "implies": ["erlang"],
     "conditions": [{"header": "Server", "regex": "^Cowboy"}]},
    {"id": "erlang", "name": "Erlang/OTP", "category": "language", "conditions": [{"header": "Server", "regex": "^(?:Cowboy|Yaws|MochiWeb)"}]},
    {"id": "python", "name": "Python", "category": "language", "website": "https://www.python.org",
     "conditions": [{"header": "Server", "regex": "Python/([\\d.]+)", "version": "$1"}]},
    {"id": "java", "name": "Java", "category": "language", "confidence": 80,
     "conditions": [{"cookie": "JSESSIONID"}, {"header": "X-Powered-By", "regex": "(?:Servlet|JSP)"}]}
  ]
}
