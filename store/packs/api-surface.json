{
  "plonix_pack": 1,
  "name": "api-surface",
  "version": "1.0.0",
  "description": "API styles, API documentation and identity endpoints worth a closer look.",
  "author": "Plonix contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SergeyMalych/plonix",
  "rules": [
    {"id": "graphql", "name": "GraphQL", "category": "api", "website": "https://graphql.org",
     "conditions": [{"path": "/graphql/?$"}, {"path": "/graphiql/?$"}, {"body": "^\\{\"data\":\\{\"__schema\""}, {"body": "^\\{\"errors\":\\[\\{\"message\":\"[^\"]*\",\"locations\""}]},
    {"id": "openapi", "name": "OpenAPI / Swagger docs", "category": "api", "website": "https://www.openapis.org",
     "description": "Machine-readable API description; lists endpoints and parameters.",
     "conditions": [{"path": "/(?:swagger|openapi)(?:\\.json|\\.yaml|\\.yml)$"}, {"path": "/v[23]/api-docs/?$"}, {"path": "/swagger-ui(?:\\.html|/)"},
                    {"body": "^\\s*\\{\\s*\"(?:swagger|openapi)\"\\s*:\\s*\"([\\d.]+)\"", "version": "$1"}]},
    {"id": "grpc-web", "name": "gRPC-Web", "category": "api", "website": "https://grpc.io",
     "conditions": [{"request_header": "Content-Type", "regex": "^application/grpc-web"}, {"header": "grpc-status"}]},
    {"id": "jsonrpc", "name": "JSON-RPC", "category": "api", "confidence": 80,
     "conditions": [{"body": "^\\s*\\{\\s*\"jsonrpc\"\\s*:\\s*\"2\\.0\""}]},
    {"id": "soap", "name": "SOAP", "category": "api",
     "conditions": [{"request_header": "SOAPAction"}, {"body": "<(?:soap|SOAP-ENV|s):Envelope"}, {"query_param": "wsdl"}]},
    {"id": "spring-actuator", "name": "Spring Boot Actuator", "category": "devops", "implies": ["spring"],
     "description": "Management endpoints; env, heapdump and similar can leak secrets.",
     "conditions": [{"path": "^/(?:[^/]+/)?actuator(?:/|$)"}, {"body": "^\\{\"_links\":\\{\"self\":\\{\"href\":\"[^\"]*/actuator\""}]},
    {"id": "oidc", "name": "OpenID Connect", "category": "auth", "website": "https://openid.net/connect/",
     "conditions": [{"path": "^/\\.well-known/openid-configuration$"}, {"query_param": "id_token_hint"},
                    {"query_param": "response_type", "regex": "id_token"}]},
    {"id": "oauth2", "name": "OAuth 2.0", "category": "auth", "website": "https://oauth.net/2/", "confidence": 90,
     "conditions": [{"path": "/oauth2?/(?:authorize|token)$"}, {"query_param": "client_id"}], "match": "any"},
    {"id": "keycloak", "name": "Keycloak", "category": "auth", "website": "https://www.keycloak.org", "implies": ["oidc"],
     "conditions": [{"path": "^/(?:auth/)?realms/[^/]+/protocol/openid-connect/"}, {"cookie": "KEYCLOAK_SESSION"}, {"cookie": "KC_RESTART"}]},
    {"id": "auth0", "name": "Auth0", "category": "auth", "website": "https://auth0.com", "implies": ["oidc"],
     "conditions": [{"host": "\\.auth0\\.com$"}, {"cookie": "auth0"}]},
    {"id": "okta", "name": "Okta", "category": "auth", "website": "https://www.okta.com",
     "conditions": [{"host": "\\.(?:okta|oktapreview)\\.com$"}]},
    {"id": "jwt", "name": "JSON Web Tokens", "category": "auth", "confidence": 90,
     "conditions": [{"request_header": "Authorization", "regex": "^Bearer eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\."}]},
    {"id": "google-analytics", "name": "Google Analytics", "category": "analytics",
     "conditions": [{"host": "^(?:www\\.)?google-analytics\\.com$"}, {"host": "^(?:www\\.)?googletagmanager\\.com$"}, {"cookie": "_ga"}]},
    {"id": "sentry", "name": "Sentry", "category": "devops", "website": "https://sentry.io",
     "conditions": [{"host": "(?:^|\\.)ingest\\.(?:[a-z]+\\.)?sentry\\.io$"}, {"request_header": "X-Sentry-Auth"}]}
  ]
}
