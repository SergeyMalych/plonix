{
  "plonix_pack": 1,
  "name": "frameworks",
  "version": "1.0.0",
  "description": "Server-side languages and web frameworks, from headers, cookies and markup.",
  "author": "Plonix contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SergeyMalych/plonix",
  "rules": [
    {"id": "php", "name": "PHP", "category": "language", "website": "https://www.php.net",
     "conditions": [{"header": "X-Powered-By", "regex": "PHP(?:/([\\d.]+))?", "version": "$1"}, {"cookie": "PHPSESSID"}, {"path": "\\.php$"}]},
    {"id": "aspnet", "name": "ASP.NET", "category": "framework", "website": "https://dotnet.microsoft.com/apps/aspnet",
     "conditions": [{"header": "X-AspNet-Version", "regex": "([\\d.]+)", "version": "$1"}, {"header": "X-AspNetMvc-Version"},
                    {"header": "X-Powered-By", "regex": "^ASP\\.NET"}, {"cookie": "ASP.NET_SessionId"}, {"cookie": ".AspNetCore.Session"},
                    {"cookie": ".AspNetCore.Antiforgery", "regex": "."}, {"path": "\\.(?:aspx|ashx|asmx|axd)$"}]},
    {"id": "express", "name": "Express", "category": "framework", "website": "https://expressjs.com", "implies": ["nodejs"],
     "conditions": [{"header": "X-Powered-By", "regex": "^Express$"}, {"cookie": "connect.sid"}]},
    {"id": "nodejs", "name": "Node.js", "category": "language", "website": "https://nodejs.org", "confidence": 80,
     "conditions": [{"header": "X-Powered-By", "regex": "(?:Express|Next\\.js|Nuxt|Koa)"}]},
    {"id": "nextjs", "name": "Next.js", "category": "framework", "website": "https://nextjs.org", "implies": ["react", "nodejs"],
     "conditions": [{"header": "X-Powered-By", "regex": "^Next\\.js(?: ([\\d.]+))?", "version": "$1"}, {"path": "^/_next/"},
                    {"header": "x-nextjs-cache"}, {"body": "<script id=\"__NEXT_DATA__\""}]},
    {"id": "nuxt", "name": "Nuxt", "category": "framework", "website": "https://nuxt.com", "implies": ["vue"],
     "conditions": [{"path": "^/_nuxt/"}, {"body": "window\\.__NUXT__"}]},
    {"id": "react", "name": "React", "category": "javascript", "website": "https://react.dev", "confidence": 90,
     "conditions": [{"body": "data-reactroot"}, {"path": "/react(?:-dom)?(?:\\.production)?(?:\\.min)?\\.js$"}]},
    {"id": "vue", "name": "Vue.js", "category": "javascript", "website": "https://vuejs.org", "confidence": 90,
     "conditions": [{"body": "data-v-[0-9a-f]{8}"}, {"path": "/vue(?:\\.runtime)?(?:\\.global)?(?:\\.prod)?(?:\\.min)?\\.js$"}]},
    {"id": "angular", "name": "Angular", "category": "javascript", "website": "https://angular.dev",
     "conditions": [{"body": "ng-version=\"([\\d.]+)\"", "version": "$1"}]},
    {"id": "jquery", "name": "jQuery", "category": "javascript", "website": "https://jquery.com",
     "conditions": [{"path": "/jquery[.-]([\\d.]+?)(?:\\.min)?\\.js$", "version": "$1"}, {"path": "/jquery(?:\\.min)?\\.js$"}]},
    {"id": "django", "name": "Django", "category": "framework", "website": "https://www.djangoproject.com", "implies": ["python"],
     "conditions": [{"cookie": "csrftoken"}, {"cookie": "django_language"}, {"body": "name=\"csrfmiddlewaretoken\""}]},
    {"id": "flask", "name": "Flask", "category": "framework", "website": "https://flask.palletsprojects.com", "implies": ["python"], "confidence": 60,
     "conditions": [{"cookie": "session", "regex": "^\\.?eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}]},
    {"id": "fastapi", "name": "FastAPI", "category": "framework", "website": "https://fastapi.tiangolo.com", "implies": ["python"],
     "conditions": [{"body": "<title>FastAPI - Swagger UI</title>"}, {"body": "\"openapi\":\"3[^\"]*\",\"info\":\\{\"title\":\"FastAPI\""}]},
    {"id": "rails", "name": "Ruby on Rails", "category": "framework", "website": "https://rubyonrails.org", "implies": ["ruby"],
     "conditions": [{"header": "X-Runtime", "regex": "^[\\d.]+$"}, {"cookie": "_session_id"}, {"body": "<meta name=\"csrf-param\" content=\"authenticity_token\""},
                    {"header": "X-Powered-By", "regex": "Phusion Passenger"}], "confidence": 80},
    {"id": "ruby", "name": "Ruby", "category": "language", "website": "https://www.ruby-lang.org",
     "conditions": [{"header": "Server", "regex": "^(?:Puma|Unicorn|WEBrick|Thin)\\b"}]},
    {"id": "laravel", "name": "Laravel", "category": "framework", "website": "https://laravel.com", "implies": ["php"],
     "conditions": [{"cookie": "laravel_session"}, {"cookie": "XSRF-TOKEN", "regex": "^eyJpdiI6"}]},
    {"id": "symfony", "name": "Symfony", "category": "framework", "website": "https://symfony.com", "implies": ["php"],
     "conditions": [{"header": "X-Debug-Token"}, {"header": "X-Debug-Token-Link"}, {"path": "^/_profiler"}]},
    {"id": "spring", "name": "Spring", "category": "framework", "website": "https://spring.io", "implies": ["java"],
     "conditions": [{"body": "<h1>Whitelabel Error Page</h1>"}, {"path": "^/actuator(?:/|$)"}, {"header": "X-Application-Context"}]},
    {"id": "go", "name": "Go", "category": "language", "website": "https://go.dev", "confidence": 60,
     "conditions": [{"body": "^404 page not found\\n?$"}]}
  ]
}
