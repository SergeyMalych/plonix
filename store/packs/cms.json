{
  "plonix_pack": 1,
  "name": "cms",
  "version": "1.0.0",
  "description": "Content management systems and e-commerce platforms.",
  "author": "Plonix contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SergeyMalych/plonix",
  "rules": [
    {"id": "wordpress", "name": "WordPress", "category": "cms", "website": "https://wordpress.org", "implies": ["php"],
     "conditions": [{"path": "^/wp-(?:content|includes|admin|json)/"}, {"path": "^/wp-login\\.php"},
                    {"body": "<meta name=\"generator\" content=\"WordPress ?([\\d.]+)?", "version": "$1"},
                    {"header": "Link", "regex": "rel=\"https://api\\.w\\.org/\""}, {"cookie": "wordpress_test_cookie"}]},
    {"id": "drupal", "name": "Drupal", "category": "cms", "website": "https://www.drupal.org", "implies": ["php"],
     "conditions": [{"header": "X-Generator", "regex": "^Drupal ?(\\d+)?", "version": "$1"}, {"header": "X-Drupal-Cache"},
                    {"header": "X-Drupal-Dynamic-Cache"}, {"path": "^/sites/(?:default|all)/(?:files|modules|themes)/"},
                    {"body": "<meta name=\"Generator\" content=\"Drupal ?(\\d+)?", "version": "$1"}]},
    {"id": "joomla", "name": "Joomla", "category": "cms", "website": "https://www.joomla.org", "implies": ["php"],
     "conditions": [{"body": "<meta name=\"generator\" content=\"Joomla!"}, {"path": "^/administrator/(?:index\\.php)?$"},
                    {"path": "^/media/jui/"}]},
    {"id": "ghost", "name": "Ghost", "category": "cms", "website": "https://ghost.org", "implies": ["nodejs"],
     "conditions": [{"body": "<meta name=\"generator\" content=\"Ghost ([\\d.]+)\"", "version": "$1"}, {"path": "^/ghost/api/"},
                    {"header": "X-Ghost-Cache-Status"}]},
    {"id": "magento", "name": "Magento", "category": "ecommerce", "website": "https://business.adobe.com/products/magento/magento-commerce.html", "implies": ["php"],
     "conditions": [{"cookie": "X-Magento-Vary"}, {"header": "X-Magento-Cache-Debug"}, {"path": "^/static/version\\d+/frontend/"},
                    {"body": "Mage\\.Cookies"}]},
    {"id": "shopify", "name": "Shopify", "category": "ecommerce", "website": "https://www.shopify.com",
     "conditions": [{"host": "\\.myshopify\\.com$"}, {"header": "X-ShopId"}, {"header": "X-Shopify-Stage"}, {"body": "cdn\\.shopify\\.com"}]},
    {"id": "woocommerce", "name": "WooCommerce", "category": "ecommerce", "website": "https://woocommerce.com", "implies": ["wordpress"],
     "conditions": [{"path": "^/wp-content/plugins/woocommerce/"}, {"path": "^/wp-json/wc/"}, {"cookie": "woocommerce_items_in_cart"}]},
    {"id": "prestashop", "name": "PrestaShop", "category": "ecommerce", "website": "https://www.prestashop.com", "implies": ["php"],
     "conditions": [{"header": "Powered-By", "regex": "^PrestaShop"}, {"cookie": "PrestaShop-*"}, {"body": "var prestashop = "}]},
    {"id": "contentful", "name": "Contentful", "category": "cms", "website": "https://www.contentful.com",
     "conditions": [{"host": "^(?:cdn|preview|graphql|images)\\.contentful\\.com$"}, {"host": "^images\\.ctfassets\\.net$"}]},
    {"id": "strapi", "name": "Strapi", "category": "cms", "website": "https://strapi.io", "implies": ["nodejs"],
     "conditions": [{"header": "X-Powered-By", "regex": "^Strapi"}, {"path": "^/admin/strapi"}]}
  ]
}
