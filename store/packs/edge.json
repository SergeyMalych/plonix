{
  "plonix_pack": 1,
  "name": "edge",
  "version": "1.0.0",
  "description": "CDNs, WAFs, caches and hosting platforms in front of the application.",
  "author": "Plonix contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SergeyMalych/plonix",
  "rules": [
    {"id": "cloudflare", "name": "Cloudflare", "category": "cdn", "website": "https://www.cloudflare.com",
     "conditions": [{"header": "CF-RAY"}, {"header": "Server", "regex": "^cloudflare$"}, {"cookie": "__cf_bm"}, {"cookie": "__cflb"}]},
    {"id": "cloudflare-waf", "name": "Cloudflare WAF challenge", "category": "waf", "implies": ["cloudflare"],
     "conditions": [{"cookie": "cf_clearance"}, {"path": "^/cdn-cgi/challenge-platform/"}]},
    {"id": "fastly", "name": "Fastly", "category": "cdn", "website": "https://www.fastly.com",
     "conditions": [{"header": "X-Served-By", "regex": "^cache-[a-z0-9-]+"}, {"header": "Fastly-Debug-Digest"}, {"header": "X-Fastly-Request-ID"}]},
    {"id": "akamai", "name": "Akamai", "category": "cdn", "website": "https://www.akamai.com",
     "conditions": [{"header": "Server", "regex": "^AkamaiGHost"}, {"header": "X-Akamai-Transformed"}, {"cookie": "ak_bmsc"}, {"cookie": "_abck"}]},
    {"id": "cloudfront", "name": "Amazon CloudFront", "category": "cdn", "website": "https://aws.amazon.com/cloudfront/", "implies": ["aws"],
     "conditions": [{"header": "X-Amz-Cf-Id"}, {"header": "Via", "regex": "\\(CloudFront\\)"}]},
    {"id": "aws-elb", "name": "AWS Elastic Load Balancing", "category": "load-balancer", "implies": ["aws"],
     "conditions": [{"cookie": "AWSALB"}, {"cookie": "AWSALBCORS"}, {"cookie": "AWSELB"}, {"header": "Server", "regex": "^awselb"}]},
    {"id": "aws", "name": "Amazon Web Services", "category": "hosting", "website": "https://aws.amazon.com",
     "conditions": [{"header": "x-amz-request-id"}, {"header": "x-amzn-RequestId"}, {"header": "Server", "regex": "^AmazonS3$"}]},
    {"id": "aws-s3", "name": "Amazon S3", "category": "hosting", "implies": ["aws"],
     "conditions": [{"header": "Server", "regex": "^AmazonS3$"}, {"host": "\\.s3[.-](?:[a-z0-9-]+\\.)?amazonaws\\.com$"}]},
    {"id": "google-cloud", "name": "Google Cloud", "category": "hosting", "confidence": 80,
     "conditions": [{"header": "Server", "regex": "^(?:Google Frontend|gws|ESF)$"}, {"header": "X-Cloud-Trace-Context"}, {"header": "X-GUploader-UploadID"}]},
    {"id": "azure", "name": "Microsoft Azure", "category": "hosting",
     "conditions": [{"header": "X-Azure-Ref"}, {"header": "X-MSEdge-Ref"}, {"cookie": "ARRAffinity"}, {"host": "\\.azurewebsites\\.net$"}]},
    {"id": "vercel", "name": "Vercel", "category": "hosting", "website": "https://vercel.com",
     "conditions": [{"header": "X-Vercel-Id"}, {"header": "Server", "regex": "^Vercel$"}]},
    {"id": "netlify", "name": "Netlify", "category": "hosting", "website": "https://www.netlify.com",
     "conditions": [{"header": "X-NF-Request-ID"}, {"header": "Server", "regex": "^Netlify$"}]},
    {"id": "heroku", "name": "Heroku", "category": "hosting", "website": "https://www.heroku.com",
     "conditions": [{"header": "Via", "regex": "\\bvegur\\b"}, {"host": "\\.herokuapp\\.com$"}]},
    {"id": "varnish", "name": "Varnish", "category": "cache", "website": "https://varnish-cache.org",
     "conditions": [{"header": "X-Varnish"}, {"header": "Via", "regex": "varnish"}]},
    {"id": "imperva", "name": "Imperva / Incapsula", "category": "waf", "website": "https://www.imperva.com",
     "conditions": [{"header": "X-Iinfo"}, {"cookie": "incap_ses_*"}, {"cookie": "visid_incap_*"}, {"header": "X-CDN", "regex": "Incapsula"}]},
    {"id": "sucuri", "name": "Sucuri", "category": "waf", "website": "https://sucuri.net",
     "conditions": [{"header": "X-Sucuri-ID"}, {"header": "Server", "regex": "^Sucuri"}]},
    {"id": "aws-waf", "name": "AWS WAF", "category": "waf", "implies": ["aws"],
     "conditions": [{"cookie": "aws-waf-token"}, {"header": "x-amzn-waf-action"}]}
  ]
}
