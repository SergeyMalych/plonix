{
  "plonix_extension_package": 1,
  "manifest": {
    "plonix_extension": 1,
    "name": "secret-sweep",
    "version": "1.0.0",
    "description": "Finds API keys, tokens and passwords for hundreds of services in captured traffic and shows each one in the Lens.",
    "author": "Plonix contributors",
    "homepage": "https://github.com/SergeyMalych/plonix",
    "runtime": "program",
    "program": "trufflehog",
    "capabilities": [
      "read-traffic",
      "passive-analysis",
      "run-program"
    ]
  }
}
