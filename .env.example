# Plonix local environment — copy to .env and fill in.
# .env is gitignored; never commit real secrets. Leave unused keys blank.
#
# Optional API keys for recon tools that Market extensions may drive.
# These are read from the local environment only; Plonix never transmits them.

# Passive subdomain sources (used by the subdomain-discovery extension's tool).
# Leave blank to use only the tool's keyless/free sources.
CHAOS_API_KEY=
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
GITHUB_TOKEN=
